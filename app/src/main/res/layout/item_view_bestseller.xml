<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="120dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="9.10dp">

    <!-- Products Section -->
    <LinearLayout
        android:id="@+id/llProductImages"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/bg_bestsellers"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="6.50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivProduct1"
                android:layout_width="42dp"
                android:layout_height="52dp"
                android:layout_margin="6.50dp"
                android:paddingHorizontal="3dp"
                android:visibility="gone"
                android:background="@drawable/bg_product"
                android:src="@drawable/instant"/>

            <ImageView
                android:id="@+id/ivProduct2"
                android:layout_width="42dp"
                android:layout_height="52dp"
                android:layout_margin="6.50dp"
                android:paddingHorizontal="3dp"
                android:visibility="gone"
                android:background="@drawable/bg_product"
                android:src="@drawable/masala"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivProduct3"
                android:layout_width="42dp"
                android:layout_height="52dp"
                android:layout_margin="6.50dp"
                android:paddingHorizontal="3dp"
                android:visibility="gone"
                android:background="@drawable/bg_product"
                android:src="@drawable/cold_and_juices"/>

            <TextView
                android:id="@+id/tvProductCount"
                android:layout_width="42dp"
                android:layout_height="52dp"
                android:layout_margin="6.50dp"
                android:background="@drawable/bg_product"
                android:gravity="center"
                android:visibility="gone"
                android:text="+1"
                android:textSize="19.50sp"
                android:textColor="@color/black"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Text Information Section -->
    <LinearLayout
        android:id="@+id/llTextInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="3.90dp"
        app:layout_constraintTop_toBottomOf="@+id/llProductImages"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvProductType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:textStyle="bold"
            android:text="Milk, Curd and Paner"
            android:textColor="@color/black"
            android:textSize="14.30sp"/>

        <TextView
            android:id="@+id/tvTotalProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3.90dp"
            android:layout_marginLeft="3dp"
            android:textStyle="bold"
            android:text="2 products"
            android:textColor="#847F7F"
            android:textSize="14.30sp"/>

        <TextView
            android:id="@+id/tvSeeAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5.90dp"
            android:text="Sell All"
            android:textSize="14.30sp"
            android:textColor="@color/purpel"
            android:textStyle="bold"
            android:padding="5.20dp"
            android:gravity="center"
            android:background="@drawable/bg_see_all"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
